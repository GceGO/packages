{
    "name": "gcego/rendering",
    "description": "Rendering for GCEGO Studio: renderer registry, Blade rendering of components and registered definitions, and render operations for gcego/runtime.",
    "type": "library",
    "keywords": [
        "gcego",
        "rendering",
        "blade",
        "components",
        "laravel",
        "admin"
    ],
    "homepage": "https://github.com/gcego/rendering",
    "license": "MIT",
    "authors": [
        {
            "name": "Atangageih Leke Collins",
            "email": "lekeatenga@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "gcego/blueprints": "^1.0",
        "gcego/components": "^0.1",
        "gcego/core": "^1.0",
        "gcego/registry": "^1.1",
        "gcego/runtime": "^0.2",
        "illuminate/auth": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../components",
            "options": {
                "versions": {
                    "gcego/components": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../runtime",
            "options": {
                "versions": {
                    "gcego/runtime": "0.2.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Gcego\\Rendering\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gcego\\Rendering\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "benchmark": "@php benchmarks/run.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gcego\\Rendering\\RenderingServiceProvider"
            ],
            "aliases": {
                "Rendering": "Gcego\\Rendering\\Facades\\Rendering"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
