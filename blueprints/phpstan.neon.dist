includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    phpVersion:
        min: 80300
        max: 80599
    paths:
        - src
        - config
        - tests/Fixtures
        - benchmarks
    tmpDir: build/phpstan
    # Definitions and catalogs re-check values that PHPDoc describes
    # (list<class-string>, ...) because PHP does not enforce PHPDoc at runtime
    # and these APIs are called by application code and third-party packages.
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # config/gcego-blueprints.php is the package's mergeable config file: the
        # one place env() belongs. Larastan only recognizes the app's config/ directory.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/gcego-blueprints.php
