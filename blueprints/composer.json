{
    "name": "gcego/blueprints",
    "description": "Declarative feature definitions for GCEGO Admin Studio: Blueprint::define() with typed, validated, immutable definition objects, discovered through gcego/registry.",
    "type": "library",
    "keywords": [
        "gcego",
        "blueprints",
        "declarative",
        "admin",
        "laravel"
    ],
    "homepage": "https://github.com/gcego/blueprints",
    "license": "MIT",
    "authors": [
        {
            "name": "Atangageih Leke Collins",
            "email": "lekeatenga@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "gcego/core": "^1.0",
        "gcego/registry": "^1.1",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Gcego\\Blueprints\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gcego\\Blueprints\\Tests\\": "tests/",
            "App\\": "tests/Fixtures/App/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "benchmark": "@php benchmarks/run.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Gcego\\Blueprints\\BlueprintsServiceProvider"
            ]
        }
    }
}
