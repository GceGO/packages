parameters:
    level: max
    phpVersion:
        min: 80300
        max: 80599
    paths:
        - src
        - tests/Fixtures
        - benchmarks
    tmpDir: build/phpstan
    # Constructors and schema builders re-check values that PHPDoc describes
    # (list<Type>, list<PropertyDefinition>, ...) because PHP does not enforce
    # PHPDoc at runtime and these APIs are called by third-party packages.
    treatPhpDocTypesAsCertain: false
