{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "gcego/morfaw",
    "description": "Laravel component foundation for GCEGO Admin Studio, registered through ComponentServiceProvider: schemas, composition, validation, traversal and normalization.",
    "type": "library",
    "keywords": [
        "gcego",
        "components",
        "declarative",
        "schema",
        "admin"
    ],
    "homepage": "https://github.com/gcego/morfaw",
    "license": "MIT",
    "authors": [
        {
            "name": "Atangageih Leke Collins",
            "email": "lekeatenga@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/framework": "^12.0|^13.0",
        "laravel/pint": "^1.14",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Gcego\\Components\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gcego\\Components\\Tests\\Fixtures\\": "tests/Fixtures/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "check": [
            "@composer validate --strict",
            "@composer dump-autoload --optimize --strict-psr --strict-ambiguous",
            "vendor/bin/pint --test",
            "vendor/bin/phpstan analyse --debug --no-progress",
            "@test"
        ],
        "test-coverage": "vendor/bin/pest --coverage --min=90",
        "format": "vendor/bin/pint",
        "benchmark": "@php benchmarks/run.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Gcego\\Components\\ComponentServiceProvider"
            ],
            "aliases": {
                "Components": "Gcego\\Components\\Facades\\Components"
            }
        }
    },
    "archive": {
        "exclude": [
            "/vendor",
            "/build",
            "/coverage",
            "/tests",
            "/benchmarks",
            "/.github",
            "/.agents",
            "/.aws",
            "/.codex",
            "/.idea",
            "/.vscode",
            "/.env",
            "/.env.*",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/composer.lock",
            "/phpunit.xml",
            "/phpstan.neon"
        ]
    }
}
