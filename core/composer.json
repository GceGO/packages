{
    "name": "gcego/core",
    "description": "Laravel integration kernel for GCEGO Studio: configuration, lifecycle, package coordination, extensions and diagnostics.",
    "type": "library",
    "keywords": [
        "gcego",
        "laravel",
        "admin",
        "framework"
    ],
    "homepage": "https://github.com/gcego/core",
    "license": "MIT",
    "authors": [
        {
            "name": "Atangageih Leke Collins",
            "email": "lekeatenga@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer-runtime-api": "^2.2",
        "composer/semver": "^3.4",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Gcego\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gcego\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "benchmark": "@php benchmarks/run.php",
        "check": [
            "@composer validate --strict",
            "vendor/bin/pint --test",
            "vendor/bin/phpstan analyse --debug --no-progress",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gcego\\Core\\GcegoServiceProvider"
            ],
            "aliases": {
                "Gcego": "Gcego\\Core\\Facades\\Gcego"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/vendor",
            "/build",
            "/coverage",
            "/tests",
            "/benchmarks",
            "/.github",
            "/.agents",
            "/.aws",
            "/.codex",
            "/.idea",
            "/.vscode",
            "/.env",
            "/.env.*",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/composer.lock",
            "/phpunit.xml",
            "/phpstan.neon"
        ]
    }
}
