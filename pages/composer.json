{
    "name": "gcego/pages",
    "description": "Declarative pages for GCEGO Admin Studio: index, create, edit, view, dashboard and custom pages with Laravel routes, a page lifecycle, request-scoped context, page and record authorization, headers, breadcrumbs, header actions, layout composition, one reusable Livewire host and diagnostics.",
    "type": "library",
    "keywords": [
        "gcego",
        "pages",
        "admin",
        "routing",
        "livewire",
        "laravel"
    ],
    "homepage": "https://github.com/gcego/pages",
    "license": "MIT",
    "authors": [
        {
            "name": "Atangageih Leke Collins",
            "email": "lekeatenga@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "gcego/actions": "^0.1",
        "gcego/blueprints": "^0.1",
        "gcego/components": "^0.1",
        "gcego/core": "^0.1",
        "gcego/data": "^0.1",
        "gcego/forms": "^0.1",
        "gcego/infolists": "^0.1",
        "gcego/layouts": "^0.1",
        "gcego/navigation": "^0.1",
        "gcego/registry": "^0.1",
        "gcego/rendering": "^0.1",
        "gcego/security": "^0.1",
        "gcego/chroma": "^0.1",
        "gcego/tables": "^0.1",
        "gcego/widgets": "^0.1",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "livewire/livewire": "^4.4"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../components",
            "options": {
                "versions": {
                    "gcego/components": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../core",
            "options": {
                "versions": {
                    "gcego/core": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../blueprints",
            "options": {
                "versions": {
                    "gcego/blueprints": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../registry",
            "options": {
                "versions": {
                    "gcego/registry": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../runtime",
            "options": {
                "versions": {
                    "gcego/runtime": "0.2.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../chroma",
            "options": {
                "versions": {
                    "gcego/chroma": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../data",
            "options": {
                "versions": {
                    "gcego/data": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../security",
            "options": {
                "versions": {
                    "gcego/security": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../actions",
            "options": {
                "versions": {
                    "gcego/actions": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../forms",
            "options": {
                "versions": {
                    "gcego/forms": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../tables",
            "options": {
                "versions": {
                    "gcego/tables": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../infolists",
            "options": {
                "versions": {
                    "gcego/infolists": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../widgets",
            "options": {
                "versions": {
                    "gcego/widgets": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../layouts",
            "options": {
                "versions": {
                    "gcego/layouts": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../navigation",
            "options": {
                "versions": {
                    "gcego/navigation": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../luminaries",
            "options": {
                "versions": {
                    "gcego/luminaries": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../swatches",
            "options": {
                "versions": {
                    "gcego/swatches": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../rendering",
            "options": {
                "versions": {
                    "gcego/rendering": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Gcego\\Pages\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gcego\\Pages\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gcego\\Pages\\PagesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
