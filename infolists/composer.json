{
    "name": "gcego/infolists",
    "description": "Declarative record details for GCEGO Admin Studio: read-only entries, relationships, sections, grids, tabs, field authorization and secure Blade/Livewire rendering.",
    "type": "library",
    "keywords": [
        "gcego",
        "infolists",
        "record",
        "details",
        "livewire",
        "laravel",
        "admin"
    ],
    "homepage": "https://github.com/gcego/infolists",
    "license": "MIT",
    "authors": [
        {
            "name": "Atangageih Leke Collins",
            "email": "lekeatenga@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "gcego/actions": "^0.1",
        "gcego/blueprints": "^0.1",
        "gcego/components": "^0.1",
        "gcego/core": "^0.1",
        "gcego/data": "^0.1",
        "gcego/registry": "^0.1",
        "gcego/runtime": "^0.1",
        "gcego/security": "^0.1",
        "gcego/chroma": "^0.1",
        "gcego/tables": "^0.1",
        "illuminate/cache": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "league/commonmark": "^2.7",
        "livewire/livewire": "^4.4",
        "php": "^8.3",
        "symfony/html-sanitizer": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "gcego/forms": "^0.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../components",
            "options": {
                "versions": {
                    "gcego/components": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../core",
            "options": {
                "versions": {
                    "gcego/core": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../blueprints",
            "options": {
                "versions": {
                    "gcego/blueprints": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../registry",
            "options": {
                "versions": {
                    "gcego/registry": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../runtime",
            "options": {
                "versions": {
                    "gcego/runtime": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../chroma",
            "options": {
                "versions": {
                    "gcego/chroma": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../data",
            "options": {
                "versions": {
                    "gcego/data": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../security",
            "options": {
                "versions": {
                    "gcego/security": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../actions",
            "options": {
                "versions": {
                    "gcego/actions": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../forms",
            "options": {
                "versions": {
                    "gcego/forms": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../tables",
            "options": {
                "versions": {
                    "gcego/tables": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../luminaries",
            "options": {
                "versions": {
                    "gcego/luminaries": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../swatches",
            "options": {
                "versions": {
                    "gcego/swatches": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Gcego\\Infolists\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gcego\\Infolists\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gcego\\Infolists\\InfolistsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
