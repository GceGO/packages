{
    "name": "gcego/runtime",
    "description": "Execution kernel for GCEGO Studio: operation dispatch, trusted execution contexts, typed handlers and fail-closed authorization.",
    "type": "library",
    "keywords": [
        "gcego",
        "runtime",
        "execution",
        "kernel",
        "laravel",
        "admin"
    ],
    "homepage": "https://github.com/gcego/runtime",
    "license": "MIT",
    "authors": [
        {
            "name": "Atangageih Leke Collins",
            "email": "lekeatenga@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "gcego/blueprints": "^1.0",
        "gcego/core": "^1.0",
        "gcego/registry": "^1.1",
        "illuminate/auth": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Gcego\\Runtime\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gcego\\Runtime\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "benchmark": "@php benchmarks/run.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gcego\\Runtime\\RuntimeServiceProvider"
            ],
            "aliases": {
                "Runtime": "Gcego\\Runtime\\Facades\\Runtime"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
